<h3 class="ui header x-title"></h3>
<table class="ui selectable celled table">
  <thead>
    <tr>
      <th class="collapsing"><%= _('#') %></th>
      <th class="collapsing"><%= _('Screen') %></th>
      <th><%= _('Error') %></th>
      <th class="collapsing"><%= _('Action') %></th>
    </tr>
  </thead>
</table>
<%_ script.create('JQuery')
  .useDependencies(['SemanticUI/Loader', 'SemanticUI/Dialog/Confirm'])
  .add(`
$.error = $.loader($('div[data-tab="error"] table'), {
    url: '${route('Ui', {name: 'error', page: 'PAGE'})}',
    formatRow(item) {
        return this.toRow(item);
    },
    loaded(json) {
        const self = this;
        if (json.count !== undefined) {
            const counter = $('[data-tab="error"] .label');
            if (json.count) {
                counter.text(json.count).removeClass('hidden');
            } else {
                counter.addClass('hidden');
            }
        }
        $('a.err-clicker').on('click', function(e) {
            e.preventDefault();
            self.handle($(this));
        });
        if (self.loading) {
            self.loading = false;
        }
    }
});
$.error.toRow = function(data) {
    return $(\`
      <tr><td class="collapsing">\${data.nr}</td>
        <td class="collapsing">\${this.toImg($.toStr(data.imgfilename), data.imgfilename)}</td>
        <td>\${this.toPayload(data.error, '${_('Error Message')}')}</td>
        <td class="collapsing">
          <a href="#" class="err-clicker" data-op="view" data-filename="\${data.srcfilename}" data-title="${_('Page Source')}" data-tooltip="${_('View page source')}" role="button"><i class="eye outline green icon"></i></a>
          <a href="#" class="err-clicker" data-op="view" data-filename="\${data.datafilename}" data-title="${_('Data Payload')}" data-tooltip="${_('View data payload')}" role="button"><i class="server icon"></i></a>
          <a href="#" class="err-clicker" data-op="delete" data-filename="\${data.imgfilename}" data-tooltip="${_('Delete')}" role="button"><i class="trash alternate outline red icon"></i></a>
        </td>
      </tr>\`);
}
$.error.toImg = function(data, alt) {
    if (data) {
        return \`
          <a href="#" class="err-clicker" data-op="view" data-title="\${alt}" data-tooltip="\${alt}" data-position="right center">
            <img class="ui medium rounded bordered image" src="\${'${route('Ui', {name: 'capture', filename: 'FILENAME'})}'.replace(/FILENAME/, data)}" alt="\${alt}">
          </a>\`;
    }
}
$.error.toPayload = function(data, title, filename) {
    if (typeof data === 'string' && data.startsWith('{')) {
        try {
            data = JSON.parse(data);
        }
        catch (err) {
        }
    }
    let excerpt, payload;
    if (data) {
        payload = $.toStr(data);
        excerpt = payload;
        if (excerpt.length > 100) {
            excerpt = excerpt.substr(0, 100);
            if (excerpt.includes('\\n')) {
                excerpt = excerpt.substr(0, excerpt.lastIndexOf('\\n'));
            } else if (excerpt.includes(' ')) {
                excerpt = excerpt.substr(0, excerpt.lastIndexOf(' '));
            } else if (excerpt.includes('-')) {
                excerpt = excerpt.substr(0, excerpt.lastIndexOf('-'));
            }
            excerpt += '&hellip;';
        }
    } else {
        excerpt = '&hellip;';
        payload = '';
    }
    const url = filename ? '${route('Ui', {name: 'capture', filename: 'FILENAME'})}'.replace(/FILENAME/, filename) : '#';
    return \`
        <a href="\${url}" class="err-clicker" data-op="view" data-title="\${title}">
        <span>\${excerpt}</span>
        <pre style="display: none;">\${payload}</pre>
        </a>\`;
}
$.error.handle = function(el) {
    const self = this;
    switch (el.data('op')) {
        case 'view':
            let url, content, scrollable = true, size = 'large';
            const img = el.find('img'), pre = el.find('pre'), filename = el.data('filename');
            if (img.length) {
                content = \`<img class="ui fluid image v-max" src="\${img.attr('src')}">\`;
                size = 'fullscreen';
                scrollable = false;
            }
            if (pre.length) {
                if (el.attr('href') !== '#') {
                    url = el.attr('href');
                } else {
                    content = \`<pre>\${$.safeStr(pre.text())}</pre>\`;
                }
            }
            if (filename && !url) {
                url = '${route('Ui', {name: 'capture', filename: 'FILENAME'})}'.replace(/FILENAME/, filename);
            }
            if (url) {
                content = \`
                    <div class="ui placeholder">
                        <div class="line"></div>
                        <div class="line"></div>
                        <div class="line"></div>
                        <div class="line"></div>
                        <div class="line"></div>
                    </div>\`;
            }
            if (scrollable) {
                content = \`<div class="ui fluid scrolling container">\${content}</div>\`;
            }
            const dlg = $.ntdlg.create('err-view-dlg', el.data('title'), content, {
                size,
                buttons: {
                    okay: {
                        type: 'green approve',
                        caption: '<i class="check icon"></i>${_('Ok')}',
                    }
                },
                show() {
                    if (url) {
                        $.get(url)
                            .done(function(data) {
                                $.fixBuffer(data);
                                const content = typeof data === 'object' ? JSON.stringify(data, null, 2) : $.safeStr(data);
                                $('#err-view-dlg .container').html(\`<pre>\${content}</pre>\`);
                            });
                    }
                }
            });
            $.ntdlg.show(dlg);
            break;
        case 'delete':
            $.ntdlg.confirm(
                'err-delete-confirm-dlg',
                '${_('Confirm')}',
                '${_('Are you sure want to remove error <span class="ui error text">%ERR%</span>?')}'.replace(/%ERR%/g, el.data('filename')),
                $.ntdlg.ICON_QUESTION,
                function() {
                    $.post('${route('Ui', {name: 'task', op: 'remove'})}', {error: el.data('filename')})
                        .done(function(json) {
                            $.tasks.notify(json);
                            if (json.success) {
                                self.reload();
                            }
                        });
                }
            );
            break;
    }
}
$.error.reload = function() {
    const self = this;
    if (!self.loading) {
        self.loading = true;
        self.load();
    }
}
`)
  .addInitializer(`
$.error.load();
`) -%>
